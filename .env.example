# Copy to .env.local for local development. Never commit real values.
# This is a static site with no production secrets — only public,
# build-time NEXT_PUBLIC_* values are supported (they are inlined into the
# client bundle). Use clearly invalid placeholders here.

NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_PHONE=+10000000000
NEXT_PUBLIC_EMAIL=example@example.invalid

# Optional. Leave empty to hide the scheduling call-to-action in the build.
NEXT_PUBLIC_SCHEDULING_URL=
